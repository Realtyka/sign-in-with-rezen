# Copy this file to .env and fill in your client's values.
#
# This is a PUBLIC client: it runs entirely in the browser, so there is no
# client secret. Nothing secret is ever configured here — the browser
# authenticates the code exchange with PKCE alone.

# The OIDC issuer for your environment. Every endpoint (authorize, token,
# userinfo, jwks) is read from <ISSUER>/.well-known/openid-configuration —
# this is the only URL you configure by hand.
ISSUER=https://keymaker-oauth.therealbrokerage.com

# Your registered public client id.
CLIENT_ID=

# Must match a redirect URI registered for your client, byte-for-byte.
# Loopback redirects use [::1], not localhost or 127.0.0.1.
REDIRECT_URI=http://[::1]:4501/callback

# Space-separated scopes. Request only what your client was approved for.
SCOPES=openid profile email real.identity ACCOUNT_READ

# Local port this sample listens on.
PORT=4501

# The Real API host your access token calls. It pairs with ISSUER: an issuer
# and an API host belong to the same environment, and this sample never
# guesses one from the other. Set it deliberately — both are printed when the
# sample starts, so the pair in use is never a guess.
#
#   production:  ISSUER=https://keymaker-oauth.therealbrokerage.com
#                API_BASE=https://yenta.therealbrokerage.com
#
# If your Real contact gives you a different issuer for development, they give
# you the matching API host with it.
API_BASE=https://yenta.therealbrokerage.com
